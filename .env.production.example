# ============================================================
# Production Environment Template — Al-Sadiq Al-Sadouq
# Copy to .env on the DigitalOcean server and fill in values.
# NEVER commit .env to git.
# ============================================================

# --- Django ---
# Production must run with DEBUG=0 (docker-compose.prod.yml also defaults it to 0).
DEBUG=0
DJANGO_SECRET_KEY=<generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())">
# Host, CORS and CSRF values are comma-separated lists. For the live demo they are:
#   DJANGO_ALLOWED_HOSTS=alsadiqai.com
#   CORS_ALLOWED_ORIGINS=https://alsadiqai.com
#   CSRF_TRUSTED_ORIGINS=https://alsadiqai.com
DJANGO_ALLOWED_HOSTS=yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# Redirect HTTP to HTTPS inside Django (Caddy already terminates TLS). Leave on.
# Set to 0 only for a plain-HTTP staging box.
SECURE_SSL_REDIRECT=1
# Number of reverse proxies in front of Django (Caddy = 1). Throttles then ignore client-sent
# X-Forwarded-For entries. docker-compose.prod.yml already defaults this to 1.
DRF_NUM_PROXIES=1

# --- Admin account (scripts/init-prod.sh -> manage.py seed_admin) ---
# REQUIRED when DEBUG=0: seed_admin refuses to run without a password and refuses
# the public dev default. Use a long random value; never reuse it elsewhere.
DJANGO_SUPERUSER_USERNAME=<admin-username>
DJANGO_SUPERUSER_EMAIL=<admin-email>
DJANGO_SUPERUSER_PASSWORD=<strong-random-password>
# /admin is blocked at Caddy for the public. List the only client IPs or CIDR
# ranges allowed through, separated by SPACES, not commas (unlike the lists
# above), for example: ADMIN_ALLOWED_IPS=203.0.113.7 198.51.100.0/24
# Empty or unset = nobody can reach /admin. Do not put a placeholder here: a
# comma, typo or placeholder stops Caddy from starting and takes the whole site
# down. Check with the caddy validate command in docs/production-hardening.md.
ADMIN_ALLOWED_IPS=

# --- Database (PostgreSQL self-hosted in Docker) ---
POSTGRES_DB=alsadiq_db
POSTGRES_USER=alsadiq_prod
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (self-hosted in Docker) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- One-click demo (judges' "Try Al-Sadiq"; leave empty to keep it OFF) ---
# DEMO_MODE=1 turns on POST /api/demo/start (backend). VITE_DEMO_MODE=1 shows the
# landing page at "/" (frontend, build time). With DEMO_MODE=1 the backend container seeds the
# families by itself on every start (backend/docker-entrypoint.sh runs `seed_demo --ensure` once
# migrations are applied; it never wipes a family in use), so no hand-run seed_demo is needed.
# Optionally schedule `python manage.py demo_reset_expired` every ~5 minutes (privacy tidy-up).
DEMO_MODE=
# 1 on judging day; build-time, rebuild frontend (docker compose build frontend).
VITE_DEMO_MODE=
# Judging-day capacity (about 30 judges; docs/hackathon/DEMO-LOGIN.md "Judging-day settings").
# Pool size and lease below already match the code defaults. The two session limits further down
# are shown with the judging-day values (the code defaults are 3 and 6).
# Families in the pool, 1-40:
# DEMO_POOL_SIZE=40
# Seconds one visitor keeps a family. Keep 2700 unless you also change the landing copy ("45 minutes"):
# DEMO_LEASE_SECONDS=2700
# POST /api/demo/start per client IP (judges share one office IP) and /api/demo/reset per demo user:
# DEMO_START_RATE=120/hour
# DEMO_RESET_RATE=120/hour
# Gunicorn workers in the backend container:
# GUNICORN_WORKERS=3

# --- LiveKit Cloud ---
# Get these from https://cloud.livekit.io → your project → Settings → Keys
LIVEKIT_API_KEY=<from LiveKit Cloud dashboard>
LIVEKIT_API_SECRET=<from LiveKit Cloud dashboard>
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_PUBLIC_URL=wss://<your-project>.livekit.cloud

# --- OpenAI ---
OPENAI_API_KEY=<your-openai-key>
# One fast model pair, the same as .env.example and the code defaults (task 08).
# To A/B another conversation model change LLM_MODEL only (gpt-5.6-luna, gpt-6-luna; gpt-5.2 is
# the slow reference). Older gpt-4.x chat models are not used.
LLM_MODEL=gpt-5.2
# How long the voice LLM thinks before its first word (the biggest first-word factor on GPT-5/6
# models). auto (default) = the lowest value the model accepts: none for the tested models
# (gpt-5.4-mini/nano, gpt-5.2, gpt-5.6-luna, gpt-6-luna, from a table, no request); any other
# model is tested with one tiny request at session start (none, minimal, low). Or one of
# none|minimal|low|medium|high|xhigh (a value the model rejects is logged and dropped), or
# off = send nothing. See backend/conversation/agent/reasoning_effort.py.
REASONING_EFFORT=auto
# One "turn_latency {json}" log line per exchange (timings, language, tool names; no text).
# Off in production unless set: LATENCY_LOG=1 for the before and after measurement.
# LATENCY_LOG=1
# gpt-4o-mini-transcribe is the fast default; gpt-transcribe is a fair A/B. gpt-live-transcribe and
# gpt-realtime-whisper are refused (the 1.5.1 plugin cannot run them).
STT_MODEL=gpt-4o-mini-transcribe
STT_REALTIME=1
# Soft thinking sound while a slow answer is on its way: hum (default) or off. Only for turns the
# child spoke, never the greeting; ElevenLabs voice only. Clips: backend/conversation/agent/assets/fillers.
FILLER_MODE=hum
FILLER_PROBABILITY=0.5
FILLER_DELAY_S=0.25
FILLER_VOLUME=0.8
REPORTING_LLM_MODEL=gpt-5.4-mini

# --- xAI Grok TTS: manual rollback only (TTS_PROVIDER=xai). Never an automatic fallback. ---
# Leave the key out unless you may need the rollback.
XAI_API_KEY=<your-xai-key>
XAI_TTS_VOICE=leo
XAI_TTS_LANGUAGE=auto
ARABIC_TTS_LOCALE=ar-SA

# --- ElevenLabs voice (the TTS). No automatic fallback: a missing or placeholder key, a build
# error or a rejected key or voice ends the session with one clear error log and a "voice_error"
# message to the room. Only an operator can switch to xAI, by setting TTS_PROVIDER=xai. ---
TTS_PROVIDER=elevenlabs
ELEVEN_API_KEY=<your-elevenlabs-key>
ELEVEN_VOICE_ID_AR=<chosen Arabic voice id>
ELEVEN_VOICE_ID_EN=<chosen English voice id>
ELEVEN_MODEL=eleven_flash_v2_5
# STT_PROVIDER=openai (default) or scribe
STT_PROVIDER=openai

# --- STT ---
STT_LANGUAGE=en

# --- Reporting pipeline ---
REPORTING_GENERATE_QUESTS=1
REPORTING_QUESTS_DAILY_CAP=1
REPORTING_QUESTS_SKIP_IF_PENDING=0
REPORTING_QUESTS_MAX_PENDING=1
REPORTING_QUESTS_RECENT_LIMIT=10
REPORTING_GENERATE_WEEKLY_SUMMARY=1
REPORTING_WEEKLY_SUMMARY_THROTTLE_HOURS=24

# --- Demo credit and safety guards (public demo) ---
# Code: backend/conversation/demo_guards.py. Guide: docs/hackathon/demo-guards.md.
# The guards are OFF while DEBUG=1 and ON otherwise. DEMO_GUARDS=1 forces them on (even in
# DEBUG), DEMO_GUARDS=0 forces them off. A limit set to 0 means "no limit".
# They use Redis (REDIS_HOST above) and need no migration. If Redis is down they let the
# session through and log one error.
# DEMO_GUARDS=
# Seconds a session may last. Near the end Sadiq says a short goodbye, then the room closes.
# DEMO_SESSION_MAX_SECONDS=300
# Sessions per child per day (day boundary: DEMO_DAY_UTC_OFFSET_HOURS, default 3 = Riyadh).
# The count belongs to the demo family, not the visitor, and a new lease picks a random free family,
# so on a judging day raise it (5) or two judges who land on the same family hit "daily_limit".
DEMO_DAILY_SESSIONS=5
# Session starts per user per hour (429 "rate_limited" after that). Judging day: 12.
DEMO_SESSION_START_PER_HOUR=12
# Judge accounts (seed_judges, see docs/hackathon/JUDGE-ACCOUNTS.md) use these instead. Defaults:
# JUDGE_DAILY_SESSIONS=30
# JUDGE_SESSION_START_PER_HOUR=20
# Characters sent to ElevenLabs per day. Past it NEW sessions are text-only ("Sadiq's voice is
# resting"). It never switches to xAI. Set it from your credit budget. 20000 is about 10 sessions;
# for a judging day of about 30 judges at 2 voice sessions each, plan about 120000 (your plan's
# ElevenLabs credits must cover it; this is a spend decision for the lead).
# ELEVEN_DAILY_CHAR_CAP=20000
# Word-timed lip sync from ElevenLabs character timings. 0 turns it off (audio-only lip sync).
LIPSYNC_TIMELINE=1
# Word-anchored avatar gestures, carried on the lip-sync timeline. 0 turns them off.
GESTURE_EVENTS=1
# DEMO_GOODBYE_LEAD_SECONDS=20
# DEMO_SESSION_GRACE_SECONDS=10
# DEMO_DAY_UTC_OFFSET_HOURS=3
# Redis database for the counters and the throttles, DRF included (REDIS_URL overrides host, port and db).
# REDIS_GUARDS_DB=0
# REDIS_URL=
# Always-on cap on session starts per child (each one creates a LiveKit room). Default 30/hour.
# SESSION_START_USER_RATE=
# Login throttle per client IP (default 5/minute). Raise it if many judges log in from one NAT IP, e.g. 30/minute:
# AUTH_RATE=
# Kill switch: the Redis key VOICE_MODE (eleven | text | off, or xai by hand), read at each
# session start. It is not an env var. Flip it without a redeploy:
#   docker compose -f docker-compose.prod.yml exec backend python manage.py voice_mode text
# With no VOICE_MODE set, TTS_PROVIDER above decides (xai only if an operator wrote it there).

# --- Frontend (Vite embeds these at build time via docker-compose.prod.yml build args) ---
VITE_API_BASE_URL=https://yourdomain.com
# Feature flags: only the exact value 1 turns a feature on. Default 0 (off).
# Rebuild the frontend image after changing them (docker compose build frontend).
# VITE_DEMO_MODE is set once, in the one-click demo section above.
VITE_FOREST_SCENE=0

# --- Voice agent ---
# Warm job processes kept ready by the livekit_agent container. Each one preloads
# Django and the VAD model (a few hundred MB), so 1 saves RAM on a small droplet.
AGENT_NUM_IDLE_PROCESSES=1
# 1 lets the reply follow the language the child uses, Arabic or English only (the CEO's rule,
# backend/conversation/agent/turn_language.py). Default 0 (off, the lead's design): the parent
# chooses the companion's language and the prompt, the TTS and the guards keep to it, exactly as
# hk/12. With 1 the reply switches only on a clear typed message (2+ real words) or a clear
# spoken turn (3+ real words) in the other language, never on noise or another script (a move to
# English also needs a common English word, so a French or Spanish sentence does not count); the TTS
# keeps the parent's-language voice (only its language hint follows) and the speech-to-text
# stays on the parent's language. Leave it at 0. See docs/hackathon/DEPLOY-CHECKLIST.md.
# REPLY_LANGUAGE_FOLLOWS_CHILD=0

# --- Caddy (reverse proxy + auto-SSL) ---
DOMAIN=yourdomain.com
# Host ports for Caddy. Leave the defaults on the server; change them only for
# a local smoke test next to other stacks.
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Uptime monitoring ---
# Point the monitor at https://<DOMAIN>/api/health/ (no auth). It returns 200
# when the database and Redis answer, 503 otherwise.

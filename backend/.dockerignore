# Applies to backend/Dockerfile. Dockerfile.agent has its own Dockerfile.agent.dockerignore, which
# BuildKit uses INSTEAD of this file, so keep the shared lines in both.
# Never bake secrets into an image.
.env
.env.*
# Regenerated by collectstatic during the image build.
staticfiles/
db.sqlite3
**/__pycache__/
**/*.pyc
# Do NOT exclude session_moral_context/static/: the backend image serves /static/quran/ from it.

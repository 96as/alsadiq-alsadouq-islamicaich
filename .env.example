# ============================================
# Django Configuration
# ============================================
DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
# For mobile testing on a real device, append your machine's LAN IP, e.g.:
#   DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,192.168.1.50
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Password reset token expiry in seconds (default: 1 hour)
PASSWORD_RESET_TIMEOUT=3600

# ============================================
# Email (Password Reset)
# ============================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=live.smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=Al-Sadiq Al-Sadouq <hello@alsadiqai.com>

# ============================================
# PostgreSQL Database (Core Service)
# ============================================
POSTGRES_DB=alsadiq_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ============================================
# Redis Cache (Core Service)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379

# --- One-click demo (judges' "Try Al-Sadiq"; leave empty to keep it OFF) ---
# DEMO_MODE=1 turns on POST /api/demo/start (backend). VITE_DEMO_MODE=1 shows the
# landing page at "/" (frontend, build time). After enabling, seed the families once (or
# `docker compose exec backend python manage.py seed_demo --ensure`; idempotent, never wipes a
# family in use). The production image does this by itself at start (docker-entrypoint.sh).
# Optionally schedule `python manage.py demo_reset_expired` every ~5 minutes.
DEMO_MODE=
VITE_DEMO_MODE=
# Capacity (code defaults shown; see docs/hackathon/DEMO-LOGIN.md): DEMO_POOL_SIZE=40,
# DEMO_LEASE_SECONDS=2700, DEMO_START_RATE=120/hour, DEMO_RESET_RATE=120/hour.

# ============================================
# RabbitMQ (Profile: async)
# ============================================
RABBITMQ_DEFAULT_USER=rabbitmq
RABBITMQ_DEFAULT_PASS=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# ============================================
# Celery (Profile: async)
# ============================================
CELERY_BROKER_URL=amqp://rabbitmq:rabbitmq@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ============================================
# LiveKit (Profile: livekit)
# ============================================
LIVEKIT_API_KEY=APIKeyDevKey
# Must be >= 32 characters and match infra/livekit/livekit.yaml (keys section)
LIVEKIT_API_SECRET=dev_livekit_api_secret_minimum_32_chars_x
# Agent / internal (Docker agent uses ws://livekit:7880 via compose override)
LIVEKIT_URL=ws://localhost:7880
# URL the client uses to join rooms (session API). Use localhost when LiveKit publishes 7880 on the host.
# For the mobile app on a real device, set this to your machine's LAN IP, e.g. ws://192.168.1.50:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# IMPORTANT — LiveKit Cloud dashboard (manual step, not an env var):
# Set webhook URL to: https://<your-domain>/api/conversation/webhook/
# Configure this in: LiveKit Cloud Console → your project → Settings → Webhooks

# ============================================
# AI Providers (LiveKit Agent + Django + Reporting)
# ============================================
OPENAI_API_KEY=openai key here
# Django reporting pipeline (post-session reports, memory, quests)
REPORTING_LLM_MODEL=gpt-5.4-mini
# Quest LLM: master switch (0/false to disable AI quest generation entirely)
REPORTING_GENERATE_QUESTS=1
# The quest LLM sees the child's open-quest board and decides "add" or "skip" itself.
# Hard backstop: skip the LLM call when child already has this many open AI quests (0 = off)
REPORTING_QUESTS_MAX_OPEN=5
# Legacy opt-in throttle: at most one quest batch per child per local day (default off)
REPORTING_QUESTS_DAILY_CAP=0
# 1 = skip quest LLM while child has pending AI quests (use admin to mark completed until child UI exists)
REPORTING_QUESTS_SKIP_IF_PENDING=0
# Skip when pending incomplete AI quests >= this (e.g. 1 = any pending blocks new generation)
REPORTING_QUESTS_MAX_PENDING=1
# How many prior AI quests to include in the quest-generation prompt (dedup hints)
REPORTING_QUESTS_RECENT_LIMIT=10

# STT + LLM + TTS
# Default STT language (used when child profile has no explicit language preference)
STT_LANGUAGE=en
# STT model: gpt-4o-mini-transcribe is the fast default; gpt-4o-transcribe is more accurate;
# gpt-transcribe is a fair A/B. gpt-live-transcribe and gpt-realtime-whisper are refused (the
# livekit 1.5.1 plugin cannot run them, see backend/conversation/agent/stt_models.py).
STT_MODEL=gpt-4o-mini-transcribe
# 1 = realtime websocket STT (transcribe while the child speaks); 0 = buffered
STT_REALTIME=1
# Soft thinking sound while a slow answer is on its way: hum (default) or off. Only for turns the
# child spoke, never the greeting; ElevenLabs voice only. Clips: backend/conversation/agent/assets/fillers.
FILLER_MODE=hum
FILLER_PROBABILITY=0.5
FILLER_DELAY_S=0.25
FILLER_VOLUME=0.8

# Model for the LLM
# Conversation LLM: mini-class models give much faster first-token latency
# A/B: change only this line (gpt-5.6-luna, gpt-6-luna; gpt-5.2 is the slow reference) and compare
# the turn_latency log lines, which carry the model and the reasoning effort. Older gpt-4.x chat
# models are not used.
LLM_MODEL=gpt-5.4-mini
# How long the voice LLM thinks before its first word (the biggest first-word factor on GPT-5/6
# models). auto (default) = the lowest value the model accepts: none for the tested models
# (gpt-5.4-mini/nano, gpt-5.2, gpt-5.6-luna, gpt-6-luna, from a table, no request); any other
# model is tested with one tiny request at session start (none, minimal, low). Or one of
# none|minimal|low|medium|high|xhigh (a value the model rejects is logged and dropped), or
# off = send nothing. See backend/conversation/agent/reasoning_effort.py.
REASONING_EFFORT=auto
# One "turn_latency {json}" log line per exchange (timings, language, tool names; no text).
# Unset = on while DEBUG=1. Set LATENCY_LOG=1 to measure in production.
# LATENCY_LOG=1
# Open the ElevenLabs websocket at session start (default on). 0 turns it off.
# TTS_WARMUP=1
# Turn endpointing (seconds of silence before the agent starts replying)
AGENT_MIN_ENDPOINTING_DELAY=0.4
AGENT_MAX_ENDPOINTING_DELAY=3.0

# xAI Grok TTS (WebSocket): https://docs.x.ai/developers/model-capabilities/audio/text-to-speech
# ONLY used when you set TTS_PROVIDER=xai yourself (see below). It is never a fallback: if
# ElevenLabs cannot be used the session fails with a clear error, it does not switch to xAI.
XAI_API_KEY=your-xai-api-key
# Voice: leo, ara, eve, rex, sal (case-insensitive; agent lowercases for the WS URL)
XAI_TTS_VOICE=leo
# Default WS language query param (used when child profile has no explicit language preference)
XAI_TTS_LANGUAGE=auto
# Locale used for Arabic child preference
ARABIC_TTS_LOCALE=ar-SA

# ============================================
# ElevenLabs voice (default TTS) — task 07
# ============================================
# TTS_PROVIDER: elevenlabs (default) or xai.
# ElevenLabs is the voice. There is NO automatic fallback: if ELEVEN_API_KEY is missing or a
# placeholder, or the plugin cannot be built, or ElevenLabs rejects the key or voice, the agent
# logs one error naming the cause (never the key), tells the room ("voice_error") and ends the
# session. It never speaks with another voice by itself.
# xai is a manual rollback that only an operator turns on, by setting TTS_PROVIDER=xai here
# (needs XAI_API_KEY), or with the VOICE_MODE kill switch (see the demo guards below). Remove
# it again to go back to ElevenLabs.
TTS_PROVIDER=elevenlabs
# https://elevenlabs.io/app/settings/api-keys  (never commit a real key)
ELEVEN_API_KEY=your-elevenlabs-api-key
# Voice IDs per session language. Candidates: see docs/hackathon/handoffs/07-elevenlabs-facts.md
# and run scripts/voice/audition.py to hear them. Blank = Habibah, a Voice Library voice:
# add it (or your pick) to "My Voices" in ElevenLabs first. Library voices may need a paid plan.
ELEVEN_VOICE_ID_AR=
ELEVEN_VOICE_ID_EN=
# eleven_flash_v2_5 (fastest, cheapest) or eleven_multilingual_v2 (most stable, double the credits).
# eleven_v4_turbo is NOT usable with plugin 1.5.1's streaming socket and is replaced by the
# default with a warning. eleven_v3 is untested with the streaming socket.
ELEVEN_MODEL=eleven_flash_v2_5
# Calm storyteller for children (docs/hackathon/handoffs/07-elevenlabs-facts.md). Defaults shown;
# tune by ear after the audition. Speed range is 0.7-1.2.
# ELEVEN_STABILITY=0.65
# ELEVEN_SIMILARITY=0.75
# ELEVEN_STYLE=0.0
# ELEVEN_SPEAKER_BOOST=on
# ELEVEN_SPEED=0.92
# auto (default), on or off. Flash models do not normalise numbers; write numbers as words.
# "on" with flash/turbo models may be refused by the API on non-Enterprise plans.
# ELEVEN_TEXT_NORMALIZATION=auto
# Only used if the session ever turns on use_tts_aligned_transcript (it is off: the chat and the
# DB keep the LLM's original text and only the speech is cleaned). original or normalized.
# ELEVEN_ALIGNMENT=original
# on (default) tells ElevenLabs the session language. Set off if English replies in an
# Arabic session (or the reverse) sound wrong; ElevenLabs then detects the language itself.
# ELEVEN_LANGUAGE_HINT=on
# Word-timed lip sync from ElevenLabs character timings (needs the ElevenLabs voice and plugin 1.5.1). 0 turns it off.
LIPSYNC_TIMELINE=1
# Word-anchored avatar gestures, carried on the lip-sync timeline. 0 turns them off.
GESTURE_EVENTS=1

# ============================================
# Demo credit and safety guards (public demo)
# ============================================
# Code: backend/conversation/demo_guards.py. Guide: docs/hackathon/demo-guards.md.
# The guards are OFF while DEBUG=1 and ON otherwise. DEMO_GUARDS=1 forces them on (even in
# DEBUG), DEMO_GUARDS=0 forces them off. A limit set to 0 means "no limit".
# They use Redis (REDIS_HOST above) and need no migration. If Redis is down they let the
# session through and log one error.
# DEMO_GUARDS=
# Seconds a session may last. Near the end Sadiq says a short goodbye, then the room closes.
# DEMO_SESSION_MAX_SECONDS=300
# Sessions per child per day (day boundary: DEMO_DAY_UTC_OFFSET_HOURS, default 3 = Riyadh).
# DEMO_DAILY_SESSIONS=3
# Session starts per user per hour (429 "rate_limited" after that).
# DEMO_SESSION_START_PER_HOUR=6
# Judge accounts (manage.py seed_judges) use these two instead of the demo caps above.
# JUDGE_DAILY_SESSIONS=30
# JUDGE_SESSION_START_PER_HOUR=20
# Characters sent to ElevenLabs per day. Past it NEW sessions are text-only ("Sadiq's voice is
# resting"). It never switches to xAI. Set it from your credit budget.
# ELEVEN_DAILY_CHAR_CAP=20000
# DEMO_GOODBYE_LEAD_SECONDS=20
# DEMO_SESSION_GRACE_SECONDS=10
# DEMO_DAY_UTC_OFFSET_HOURS=3
# Redis database for the counters and the throttle (REDIS_URL overrides host, port and db).
# REDIS_GUARDS_DB=0
# REDIS_URL=
# Kill switch: the Redis key VOICE_MODE (eleven | text | off, or xai by hand), read at each
# session start. It is not an env var. Flip it without a redeploy:
#   docker compose -f docker-compose.prod.yml exec backend python manage.py voice_mode text
# With no VOICE_MODE set, TTS_PROVIDER above decides (xai only if an operator wrote it there).

# STT_PROVIDER: openai (default) or scribe (ElevenLabs Scribe, needs ELEVEN_API_KEY).
# Choosing scribe without a usable key fails the session clearly; it does not switch to openai.
STT_PROVIDER=openai
# STT_SCRIBE_MODEL=scribe_v2_realtime
# Caveat: plugin 1.5.1 does NOT send keyterms on scribe_v2_realtime (it only sends them for the
# batch models), so value names and Islamic terms get no keyterm boost. Getting them needs plugin
# 1.8.x, which forces a livekit-agents upgrade (not allowed here), or a custom STT subclass.
